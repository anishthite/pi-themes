{
  "name": "@anishthite/pi-themes",
  "version": "0.1.7",
  "license": "MIT",
  "description": "Theme picker and theme collection for Pi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anishthite/pi-themes.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "themes"
  ],
  "files": [
    "README.md",
    "NOTICE",
    "LICENSE",
    "extensions",
    "themes"
  ],
  "scripts": {
